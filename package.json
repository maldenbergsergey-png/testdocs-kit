{
  "name": "testdocs-kit",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Переносимый набор QA-скиллов и MCP-серверов для тестовой документации",
  "scripts": {
    "setup": "node scripts/install.mjs",
    "update": "node scripts/update.mjs",
    "update:check": "node scripts/auto-update.mjs --check --force",
    "update:status": "node scripts/auto-update.mjs --status",
    "update:configure": "node scripts/auto-update.mjs",
    "reconfigure": "node scripts/install.mjs --configure all",
    "configure:figma": "node scripts/install.mjs --configure figma --figma-mode browser",
    "configure:browser": "node scripts/install.mjs --configure browser",
    "configure:maestro": "node scripts/install.mjs --configure maestro",
    "check:maestro": "node scripts/check-maestro.mjs",
    "configure:jira": "node scripts/install.mjs --configure jira",
    "configure:confluence": "node scripts/install.mjs --configure confluence",
    "configure:sp-secret": "node scripts/install.mjs --configure sp-secret --skip-dependencies --skip-browser-auth",
    "configure:eva": "node scripts/install.mjs --configure eva",
    "configure:tms": "node scripts/install.mjs --configure tms",
    "configure:delivery": "node scripts/install.mjs --configure delivery",
    "configure:integrations": "node scripts/install.mjs --configure integrations",
    "configure:repositories": "node scripts/install.mjs --configure repositories",
    "configure:postman-repository": "node scripts/install.mjs --configure postman-repository",
    "configure:postman": "node scripts/install.mjs --configure postman",
    "configure:repository-sources": "node scripts/install.mjs --configure repository-sources",
    "configure:gitlab": "node scripts/install.mjs --configure gitlab",
    "check:gitlab": "node scripts/check-repositories.mjs --gitlab",
    "check:repositories": "node scripts/check-repositories.mjs",
    "add:jira": "node scripts/install.mjs --add jira",
    "add:confluence": "node scripts/install.mjs --add confluence",
    "add:eva": "node scripts/install.mjs --add eva",
    "auth": "node scripts/browser-auth.mjs",
    "workspace": "node scripts/task-workspace.mjs",
    "context": "node scripts/context-store.mjs",
    "check": "npm run test:checklist && node scripts/check-install.mjs",
    "test:bootstrap": "node scripts/test-bootstrap.mjs",
    "test:command-shell": "node --test scripts/command-shell.test.mjs",
    "test:installer": "node --test scripts/opencode-checklist-permissions.test.mjs scripts/client-mcp.test.mjs && node scripts/test-installer.mjs",
    "test:auto-update": "node --test scripts/auto-update.test.mjs",
    "test:mcp": "npm --prefix mcp/jira-mcp test",
    "test:qa-tools-mcp": "npm --prefix mcp/qa-tools-mcp test",
    "test:browser-auth": "node --check scripts/browser-auth.mjs",
    "test:session-auth": "node --test mcp/session-auth.test.cjs",
    "test:atlassian-transport": "npm --prefix mcp/confluence-mcp run build && node --test mcp/atlassian-transport.test.cjs",
    "test:workspace": "node --test scripts/task-workspace.test.mjs scripts/context-store.test.mjs",
    "test:format": "node scripts/validate-test-case-format.mjs",
    "test:checklist": "node scripts/validate-checklist-format.mjs && node --test scripts/validate-checklist-format.test.mjs",
    "test": "npm run test:skills && npm run test:repositories && npm run test:format && npm run test:checklist && npm run test:bootstrap && npm run test:command-shell && npm run test:browser-auth && npm run test:session-auth && npm run test:atlassian-transport && npm run test:workspace && npm run test:mcp && npm run test:qa-tools-mcp && npm run test:installer && npm run test:browser-mcp && npm run test:maestro && npm run test:auto-update",
    "test:browser-mcp": "node --test scripts/browser-mcp.test.mjs",
    "test:maestro": "node --test scripts/maestro-mcp.test.mjs",
    "test:repositories": "node --test scripts/repository-config.test.mjs",
    "test:skills": "node --test scripts/skill-pack.test.mjs scripts/install-skills.test.mjs",
    "eval:routing": "node scripts/check-routing-eval.mjs",
    "gitlab:read": "node scripts/gitlab-read.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
